<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="P2RLS.Pages.Shared.SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>P2RLS &ndash; Learn Money. Build Wealth. Secure Your Future.</title>
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" runat="server" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" runat="server" />
    
    <!-- Custom Theme Styles -->
    <link rel="stylesheet" href="~/Styles/site.css" runat="server" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <a class="skip-link" href="#mainContent">Skip to main content</a>
    <form id="form1" runat="server">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-p2rls py-3" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href="~/Default.aspx" runat="server">
                    <span class="brand-logo-badge">P2</span>
                    <span class="brand-text">P2RLS</span>
                </a>
                
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNav" aria-controls="mainNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-2 align-items-lg-center">
                        <li class="nav-item"><a class="nav-link" href="~/Pages/User/Lessons.aspx" runat="server">Academy</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/Pages/User/Simulations.aspx" runat="server">Simulations</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/Pages/User/Wallet.aspx" runat="server">Wallet</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/Pages/User/RewardShop.aspx" runat="server">Rewards</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/Pages/User/Announcements.aspx" runat="server">Announcements</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/Pages/User/Achievements.aspx" runat="server">Achievements</a></li>
                        <asp:PlaceHolder ID="phAdminLink" runat="server" Visible="false">
                            <li class="nav-item"><a class="nav-link text-primary fw-bold" href="~/Pages/Admin/Dashboard.aspx" runat="server"><i class="bi bi-shield-lock me-1"></i>Admin</a></li>
                        </asp:PlaceHolder>
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-3 navbar-user-section">
                        <asp:PlaceHolder ID="phGuestLinks" runat="server">
                            <li class="nav-item"><a class="nav-link fw-semibold px-3" href="~/Pages/User/Login.aspx" runat="server">Login</a></li>
                            <li class="nav-item"><a class="btn btn-brand px-4 py-2" href="~/Pages/User/Register.aspx" runat="server">Get Started Free</a></li>
                        </asp:PlaceHolder>

                        <asp:PlaceHolder ID="phUserLinks" runat="server" Visible="false">
                            <li class="nav-item text-nowrap">
                                <a href="~/Pages/User/Wallet.aspx" runat="server" class="badge-coin-nav">
                                    <span class="coin-icon">&#129689;</span>
                                    <span class="coin-count"><asp:Literal ID="litCoins" runat="server" /></span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a id="lnkUserProfile" class="nav-link user-profile-link d-flex align-items-center gap-2" href="~/Pages/User/Dashboard.aspx" runat="server">
                                    <div class="position-relative" style="width:32px;height:32px;min-width:32px;">
                                        <asp:Image ID="imgNavAvatar" runat="server" Visible="false"
                                            style="width:32px;height:32px;border-radius:50%;object-fit:cover;border:2px solid rgba(124,58,237,0.5);" />
                                        <div id="divNavAvatarFallback" runat="server"
                                            style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#7C3AED,#C026D3);display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;color:#fff;border:2px solid rgba(124,58,237,0.5);">
                                            <asp:Literal ID="litNavInitial" runat="server" />
                                        </div>
                                    </div>
                                    <asp:Literal ID="litUsername" runat="server" />
                                </a>
                            </li>
                            <li class="nav-item">
                                <button type="button" class="nav-link text-muted hover-danger border-0 bg-transparent" data-bs-toggle="modal" data-bs-target="#logoutModal" title="Log out">
                                    <i class="bi bi-box-arrow-right"></i>
                                </button>
                            </li>
                        </asp:PlaceHolder>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main id="mainContent" class="main-content-area">
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </main>

    <footer class="site-footer pt-5 pb-4">
        <div class="container">
            <div class="row g-4 mb-5">
                <!-- Brand Info -->
                <div class="col-lg-4 col-md-12">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="brand-logo-badge">P2</span>
                        <span class="brand-text text-white">P2RLS</span>
                    </div>
                    <p class="footer-desc mb-4">
                        Revolutionizing financial literacy through immersive learning and gamified wealth building. Designed for the next generation of investors.
                    </p>
                    <div class="d-flex gap-2">
                        <a href="~/Default.aspx" class="social-icon-btn" title="Website"><i class="bi bi-globe"></i></a>
                        <a href="~/Pages/User/Announcements.aspx" class="social-icon-btn" title="Community"><i class="bi bi-chat-dots"></i></a>
                        <a href="~/Pages/User/RewardShop.aspx" class="social-icon-btn" title="Rewards"><i class="bi bi-gift"></i></a>
                    </div>
                </div>

                <!-- Column 1: Platform -->
                <div class="col-lg-2 col-md-4 col-6">
                    <h6 class="footer-heading">PLATFORM</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a href="~/Pages/User/Lessons.aspx" runat="server">Academy Modules</a></li>
                        <li><a href="~/Pages/User/Simulations.aspx" runat="server">Market Simulations</a></li>
                        <li><a href="~/Pages/User/Achievements.aspx" runat="server">Global Leaderboard</a></li>
                        <li><a href="~/Pages/User/Wallet.aspx" runat="server">P2RLS Tokenomics</a></li>
                    </ul>
                </div>

                <!-- Column 2: Company -->
                <div class="col-lg-3 col-md-4 col-6">
                    <h6 class="footer-heading">COMPANY</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a href="~/Pages/User/Lessons.aspx" runat="server">Our Mission</a></li>
                        <li><a href="~/Pages/User/Announcements.aspx" runat="server">Announcements &amp; News</a></li>
                        <li><a href="~/Pages/User/Achievements.aspx" runat="server">Impact &amp; Progress</a></li>
                        <li><a href="~/Pages/User/RewardShop.aspx" runat="server">Partner Rewards</a></li>
                    </ul>
                </div>

                <!-- Column 3: Legal & Security -->
                <div class="col-lg-3 col-md-4 col-12">
                    <h6 class="footer-heading">LEGAL &amp; SECURITY</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a href="~/Pages/Legal/Privacy.aspx" runat="server">Privacy &amp; Security</a></li>
                        <li><a href="~/Pages/Legal/Terms.aspx" runat="server">Terms of Use</a></li>
                        <li><a href="~/Pages/Legal/RiskDisclosure.aspx" runat="server">Risk Disclosure</a></li>
                    </ul>
                </div>
            </div>

            <!-- Bottom Divider -->
            <div class="footer-bottom pt-4 border-top border-secondary border-opacity-25 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 text-muted small">
                <div>&copy; <%= DateTime.Now.Year %> P2RLS Ecosystem. All rights reserved.</div>
                <div>Empowering financial literacy and wealth building.</div>
            </div>
        </div>
    </footer>

    <!-- Custom Logout Confirmation Modal -->
    <div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
            <div class="modal-content border-0 p-4 shadow-lg text-center" style="border-radius: 24px; background: #FFFFFF;">
                <div class="modal-body p-0">
                    <div class="icon-box mx-auto mb-3" style="width: 58px; height: 58px; border-radius: 18px; background: #FEE2E2; color: #DC2626; font-size: 1.5rem; display: inline-flex; align-items: center; justify-content: center;">
                        <i class="bi bi-box-arrow-right"></i>
                    </div>
                    <h2 class="h5 fw-bold text-dark mb-2" id="logoutModalLabel">Log Out of P2RLS?</h2>
                    <p class="text-muted small mb-4" style="line-height: 1.5;">
                        Are you sure you want to end your current session? You can log back in anytime to continue your journey.
                    </p>
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <asp:LinkButton ID="lnkLogout" runat="server" CssClass="btn btn-danger rounded-pill px-4 fw-bold shadow-sm" OnClick="lnkLogout_Click">
                            Log Out
                        </asp:LinkButton>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Global Confirm Modal (shared by all delete/action confirmations) -->
    <div class="modal fade" id="globalConfirmModal" tabindex="-1" aria-labelledby="globalConfirmModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
            <div class="modal-content border-0 p-4 shadow-lg text-center" style="border-radius: 24px; background: #FFFFFF;">
                <div class="modal-body p-0">
                    <div style="width: 58px; height: 58px; border-radius: 18px; background: #FEE2E2; color: #DC2626; font-size: 1.5rem; display: inline-flex; align-items: center; justify-content: center;" class="mx-auto mb-3">
                        <i id="gcmIcon" class="bi bi-trash3-fill"></i>
                    </div>
                    <h2 class="h5 fw-bold text-dark mb-2" id="globalConfirmModalLabel">Are you sure?</h2>
                    <p id="gcmMessage" class="text-muted small mb-4" style="line-height: 1.5;"></p>
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button id="gcmConfirmBtn" type="button" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">
                            Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ── Active nav link highlighting ──────────────────────────────────
        document.addEventListener('DOMContentLoaded', function () {
            var currentPath = window.location.pathname.toLowerCase();
            var navLinks = document.querySelectorAll('.navbar-p2rls .navbar-nav .nav-link');
            
            navLinks.forEach(function (l) { l.classList.remove('active'); });

            var isAdmin = currentPath.indexOf('/admin/') !== -1;

            navLinks.forEach(function (link) {
                var text = (link.innerText || link.textContent || '').trim();
                var href = (link.getAttribute('href') || '').toLowerCase();

                if (isAdmin) {
                    if (text.indexOf('Admin') !== -1 || href.indexOf('/admin/') !== -1) {
                        link.classList.add('active');
                    }
                    return;
                }

                if (text === 'Academy') {
                    if (currentPath.indexOf('/lessons') !== -1 ||
                        currentPath.indexOf('/lessonlist') !== -1 ||
                        currentPath.indexOf('/lessonview') !== -1 ||
                        currentPath.indexOf('/quiztake') !== -1 ||
                        currentPath.indexOf('/quizresult') !== -1) {
                        link.classList.add('active');
                    }
                } else if (text === 'Simulations') {
                    if (currentPath.indexOf('/simulations') !== -1 ||
                        currentPath.indexOf('/simulationtake') !== -1 ||
                        currentPath.indexOf('/simulationresult') !== -1) {
                        link.classList.add('active');
                    }
                } else if (text === 'Wallet') {
                    if (currentPath.indexOf('/wallet') !== -1) {
                        link.classList.add('active');
                    }
                } else if (text === 'Rewards') {
                    if (currentPath.indexOf('/rewardshop') !== -1 || currentPath.indexOf('/rewards') !== -1) {
                        link.classList.add('active');
                    }
                } else if (text === 'Announcements') {
                    if (currentPath.indexOf('/announcements') !== -1) {
                        link.classList.add('active');
                    }
                } else if (text === 'Achievements') {
                    if (currentPath.indexOf('/achievements') !== -1) {
                        link.classList.add('active');
                    }
                }
            });
        });

        // ── Global Confirm Modal ──────────────────────────────────────────
        // Usage: add to any button/link:
        //   data-confirm="Your message here"
        //   data-confirm-title="Optional title"         (default: "Are you sure?")
        //   data-confirm-icon="bi-trash3-fill"          (default: bi-trash3-fill)
        //   data-confirm-btn="Delete"                   (default: "Delete")
        //
        // showConfirm(message, onConfirm, title, icon, btnLabel)
        // can also be called programmatically.
        // ─────────────────────────────────────────────────────────────────
        var _gcmOnConfirm = null;
        var _gcmModal = null;

        function showConfirm(message, onConfirm, title, icon, btnLabel) {
            document.getElementById('gcmMessage').textContent = message || 'This action cannot be undone.';
            document.getElementById('globalConfirmModalLabel').textContent = title || 'Are you sure?';
            var iconEl = document.getElementById('gcmIcon');
            iconEl.className = 'bi ' + (icon || 'bi-trash3-fill');
            document.getElementById('gcmConfirmBtn').textContent = btnLabel || 'Delete';
            _gcmOnConfirm = onConfirm || null;

            if (!_gcmModal) {
                _gcmModal = new bootstrap.Modal(document.getElementById('globalConfirmModal'));
            }
            _gcmModal.show();
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Wire the confirm button
            document.getElementById('gcmConfirmBtn').addEventListener('click', function () {
                if (_gcmModal) _gcmModal.hide();
                if (typeof _gcmOnConfirm === 'function') _gcmOnConfirm();
                _gcmOnConfirm = null;
            });

            // Auto-wire any element with [data-confirm] attribute
            document.addEventListener('click', function (e) {
                var el = e.target.closest('[data-confirm]');
                if (!el) return;

                e.preventDefault();
                e.stopImmediatePropagation();

                var msg   = el.getAttribute('data-confirm');
                var title = el.getAttribute('data-confirm-title') || 'Are you sure?';
                var icon  = el.getAttribute('data-confirm-icon')  || 'bi-trash3-fill';
                var btn   = el.getAttribute('data-confirm-btn')   || 'Delete';

                showConfirm(msg, function () {
                    // For ASP.NET LinkButtons rendered as <a> with href="javascript:__doPostBack(...)"
                    var href = el.getAttribute('href');
                    if (href && href.indexOf('__doPostBack') !== -1) {
                        // Extract __doPostBack args and call it
                        var match = href.match(/__doPostBack\('([^']+)','([^']*)'\)/);
                        if (match) {
                            __doPostBack(match[1], match[2]);
                            return;
                        }
                    }
                    // For regular buttons / inputs
                    if (el.tagName === 'INPUT' || el.tagName === 'BUTTON') {
                        el.removeAttribute('data-confirm');
                        el.click();
                        return;
                    }
                    // Fallback: follow href
                    if (href) window.location.href = href;
                }, title, icon, btn);
            }, true);
        });
    </script>
</body>
</html>
