<%@ Page Title="About Us" Language="C#" MasterPageFile="~/Pages/Shared/Site.master" AutoEventWireup="true" CodeBehind="About.aspx.cs" Inherits="P2RLS.About" %>

<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server">
    <div class="container py-5 max-w-800 mx-auto">
        <div class="card p-4 p-md-5 border-0 shadow-sm" style="border-radius: 24px; background: #FFFFFF;">
            <span class="badge badge-brand text-uppercase px-3 py-1 mb-2 rounded-pill fw-bold" style="font-size: 0.72rem; width: fit-content;">
                ABOUT P2RLS
            </span>
            <h1 class="h2 fw-bold text-dark mb-3">Empowering Financial Freedom</h1>
            <p class="text-secondary leading-relaxed mb-4">
                P2RLS (Peer-to-Real-Life-Simulation) is an interactive, gamified platform dedicated to demystifying personal finance, wealth accumulation, and risk management through experiential learning.
            </p>
            <div class="p-3 rounded-4" style="background: #F8FAFC; border: 1px solid #E2E8F0;">
                <h2 class="h6 fw-bold text-dark mb-1">Our Mission</h2>
                <p class="text-muted small mb-0">
                    To deliver practical, zero-risk financial mastery for individuals across all 6 core stages of financial maturity.
                </p>
            </div>
        </div>
    </div>
</asp:Content>
